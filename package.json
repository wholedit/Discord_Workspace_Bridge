{
  "name": "discord-workspace-bridge",
  "version": "0.1.0",
  "description": "Give tasks to Claude Code workspaces on your PC from Discord on your phone: one bot per workspace, using Anthropic's official Discord channel plugin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wholedit/Discord_Workspace_Bridge.git"
  },
  "homepage": "https://github.com/wholedit/Discord_Workspace_Bridge#readme",
  "keywords": [
    "discord",
    "claude-code",
    "remote",
    "workspace",
    "bot"
  ],
  "scripts": {
    "check": "node --use-system-ca --import tsx src/cli.ts check",
    "add": "node --use-system-ca --import tsx src/cli.ts add",
    "list": "node --use-system-ca --import tsx src/cli.ts list",
    "remove": "node --use-system-ca --import tsx src/cli.ts remove",
    "launch": "node --use-system-ca --import tsx src/cli.ts launch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node --use-system-ca --import tsx src/cli.ts start",
    "status": "node --use-system-ca --import tsx src/cli.ts status",
    "mode": "node --use-system-ca --import tsx src/cli.ts mode",
    "add-manager": "node --use-system-ca --import tsx src/cli.ts add-manager",
    "setup": "node --use-system-ca --import tsx src/cli.ts setup",
    "stop": "node --use-system-ca --import tsx src/cli.ts stop",
    "start:bg": "node --use-system-ca --import tsx src/cli.ts start-bg",
    "trust": "node --use-system-ca --import tsx src/cli.ts trust",
    "autostart": "node --use-system-ca --import tsx src/cli.ts autostart",
    "logs": "node --use-system-ca --import tsx src/cli.ts logs"
  },
  "type": "module",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "discord-workspace-bridge": "src/cli.ts"
  },
  "allowScripts": {
    "esbuild": false
  }
}
